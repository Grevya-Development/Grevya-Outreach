# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `npm run db:setup` (Project Settings → Database → Connection string, "Session pooler")
DATABASE_URL=

# ── Groq (console.groq.com/keys) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── App ──
# Password for the dashboard login
APP_PASSWORD=
# Random secret used to sign the login cookie and tracking links: `openssl rand -hex 32`
APP_SECRET=
# 32-byte key that encrypts mailbox passwords in the database: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Public URL of this app. Open/click tracking and unsubscribe links point here,
# so it must be reachable from the internet once you send real campaigns.
APP_URL=http://localhost:3000
# Protects /api/engine/tick when called by an external cron
CRON_SECRET=
# Timezone used for dashboard charts
APP_TIMEZONE=Asia/Kolkata

# Optional: Hunter.io key for extra email verification/finding coverage (free plan: 25 finds + 50 verifications/month)
HUNTER_API_KEY=
# Optional: hostname used when checking mailboxes over SMTP (defaults to mail.grevya.com)
VERIFIER_HELO=
